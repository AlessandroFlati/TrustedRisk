# TrustedRisk runtime configuration — copy to .env and customize

# Server binding
TRUSTEDRISK_PORT=8080
TRUSTEDRISK_HOST=0.0.0.0
TRUSTEDRISK_LOG_LEVEL=INFO

# Artifact paths (relative to repo root; set by porting script)
TRUSTEDRISK_COEFFICIENTS_PATH=data/coefficients.json
TRUSTEDRISK_GROUNDING_INDEX_PATH=data/grounding_index_mpnet.pkl
TRUSTEDRISK_OOD_POLICY_TYPE=topological
TRUSTEDRISK_OOD_POLICY_PATH=data/abstain_policy_topological.json
TRUSTEDRISK_COHORT_EMBEDDINGS_PATH=data/cohort_embeddings.npz

# Abstain thresholds (override defaults baked into the policy JSONs)
TRUSTEDRISK_CI_WIDTH_THRESHOLD=0.30

# Grounding embedder (must match the embedder that produced grounding_index_*.pkl)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# OPENAI_API_KEY=sk-...  # optional, only if using OpenAI-hosted embeddings

# ADK / A2A — model selection
# Default: managed Gemini (requires GOOGLE_API_KEY or Vertex ADC)
ADK_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=...  # or GOOGLE_APPLICATION_CREDENTIALS for Vertex AI
#
# Local-LLM alternatives (no external API key, requires `pip install google-adk[extensions]`)
# Ollama (local), needs `ollama serve` running and the model pulled:
#   ollama pull qwen2.5:32b-instruct
#   ADK_MODEL=ollama_chat/qwen2.5:32b-instruct
#
# Other LiteLLM-recognised providers also work — vLLM, OpenAI-compat, Anthropic, etc.
#   ADK_MODEL=openai/gpt-4o-mini       # OPENAI_API_KEY required
#   ADK_MODEL=anthropic/claude-3-5-haiku-latest   # ANTHROPIC_API_KEY required
# OLLAMA_API_BASE=http://localhost:11434  # default; override for remote Ollama

# FHIR (demo)
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Version pins for audit trail (populated by porting script)
SUPPORTED_COEFF_VERSIONS=
SUPPORTED_ABSTAIN_POLICY_VERSIONS=

# OAuth Client Credentials grant (RFC 6749 §4.4) — multi-tenant deployment
# Default: disabled (single-tenant context-only headers, OK for the demo).
TRUSTEDRISK_OAUTH_ENABLED=0
# When enabled:
#   1. Set a strong secret (≥32 random bytes) — used for HS256 signing:
TRUSTEDRISK_OAUTH_SECRET=replace-with-a-strong-secret-at-least-32-bytes
#   2. Stage a client registry. See data/oauth_clients.example.json:
TRUSTEDRISK_OAUTH_CLIENTS_PATH=data/oauth_clients.json
#   3. Optional: token TTL in seconds (default 3600, minimum 60)
TRUSTEDRISK_OAUTH_TOKEN_TTL_SECONDS=3600

# Patient memory store (SQLite, single-file). Path relative to repo root.
TRUSTEDRISK_MEMORY_DB_PATH=data/memory.sqlite3

# Fairness baseline (W5 internal calibration output). Falls back to literature defaults if absent.
TRUSTEDRISK_FAIRNESS_BASELINE_PATH=data/fairness_baseline.json

# BYO orchestrator mode: expose only 98 tools to MCP tools/list, staying
# under Gemini's 128 function-declaration cap. The dropped tools remain
# importable; only their MCP visibility is suppressed.
TRUSTEDRISK_MCP_BYO_MODE=1

# ntfy.sh topic for autostart + healthcheck push notifications
# (no-account, free). Pick any random string and subscribe to it via
# the ntfy mobile app. Required only if you run scripts/install_hardening.ps1.
TRUSTEDRISK_NTFY_TOPIC=
