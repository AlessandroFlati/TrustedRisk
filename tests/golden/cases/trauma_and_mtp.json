      "input": {
        "injuries": [{"body_region": "extremities_pelvic_girdle", "ais_severity": 2}],
        "glasgow_coma_score": 15, "systolic_bp": 125,
        "respiratory_rate": 16
      },
      "expected_subset": {
        "iss": 4, "iss_band": "minor",
        "triage_priority": "minor_injury_outpatient"
      }
    },
    {
      "name": "mtp_full_score_within_txa_window",
