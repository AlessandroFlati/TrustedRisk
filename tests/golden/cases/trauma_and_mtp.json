      "input": {
        "penetrating_mechanism": true,
        "field_or_arrival_sbp_le_90": true,
        "heart_rate_ge_120": true,
        "positive_fast_exam": true,
        "minutes_since_injury": 45
      },
      "expected_subset": {
        "abc_score": 4, "mtp_activated": true,
        "txa_indicated": true, "txa_window_open": true
      }
    },
    {
      "name": "mtp_txa_out_of_window",
