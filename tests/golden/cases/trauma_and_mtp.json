{
  "tool": "multi_tool",
  "cases": [
    {
      "name": "trauma_severe_polytrauma",
      "tool": "compute_trauma_severity_score",
      "input": {
        "injuries": [
          {"body_region": "head_neck", "ais_severity": 4},
          {"body_region": "chest", "ais_severity": 3},
          {"body_region": "abdomen_pelvis", "ais_severity": 4}
        ],
        "glasgow_coma_score": 10, "systolic_bp": 85,
        "respiratory_rate": 24, "has_active_hemorrhage": true
      },
      "expected_subset": {
        "iss": 41, "iss_band": "severe",
        "rts_band": "abnormal_physiology",
        "triage_priority": "operating_room_immediate"
      }
    },
    {
      "name": "trauma_minor_isolated_extremity",
