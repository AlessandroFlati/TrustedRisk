      "input": {
        "penetrating_mechanism": true,
        "field_or_arrival_sbp_le_90": true,
        "heart_rate_ge_120": true, "positive_fast_exam": true,
        "minutes_since_injury": 240
      },
      "expected_subset": {
        "mtp_activated": true,
        "txa_indicated": false, "txa_window_open": false
      }
